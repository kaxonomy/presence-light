# Public Worker endpoint. Use ws:// for local development and wss:// in production.
VITE_PRESENCE_WS_URL=ws://127.0.0.1:8787/ws/example-room

# Desktop runtime configuration. Do not prefix the token with VITE_.
PRESENCE_WS_URL=ws://127.0.0.1:8787/ws/example-room
PRESENCE_TOKEN=replace-with-viewer-or-controller-token
CAN_CONTROL=true
